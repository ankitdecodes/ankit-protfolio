# Copy to .env.local and fill in. Every variable is optional:
# links that are not set are simply not rendered (no placeholder URLs).

# Contact email — enables the email link, copy button and mailto composer
VITE_CONTACT_EMAIL=
# Full profile URLs
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
# Resume: an absolute URL, or put resume.pdf in public/ and use /resume.pdf
VITE_RESUME_URL=
# Shown in the About section, e.g. "Mumbai, India"
VITE_LOCATION=
# Deployed origin, e.g. https://ankitpal.dev — adds canonical + absolute og:image URLs
VITE_SITE_URL=
# Base path when served from a sub-path, e.g. /ankit-protfolio/ on GitHub Pages (default /)
VITE_BASE=
